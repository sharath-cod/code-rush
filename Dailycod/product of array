int* productExceptSelf(int* nums, int ns, int* rs) {

    *rs = ns;
    int* res =(int*)malloc(ns* sizeof(int*) );
    int prefix=1;
    for(int i=0;i<ns;i++)
    {
        res[i]=prefix;
        prefix *= nums[i];
    }

int sufix=1;
for(int i=ns-1;i>=0;i--)
{
    res[i] *=sufix;
    sufix *=nums[i];
}
return res;    
}
