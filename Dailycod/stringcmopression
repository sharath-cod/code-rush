int compress(char* chars, int cs) {
 int write = 0;
 int read = 0;


 while(read < cs)
 {
    char cur = chars[read];
    int count = 0;
 
 while(read < cs && chars[read] == cur)
 {
    read ++;
    count++;
 }

chars[write++] = cur;

if(count>1)
{
    char buf[12];
    int len = sprintf(buf,"%d",count);

    for(int i=0;i<len;i++)
    {
        chars[write++] = buf[i];
    }
}
}
return write;
}
