int maxArea(int* height, int heightSize) {
        int left = 0;
        int right = heightSize - 1;
        int maxWater = 0;

        while (left < right) {
            int width = right - left;
            int h = fmin(height[left], height[right]);

            int area = width * h;
            maxWater = fmax(maxWater, area);

            if (height[left] < height[right]) {
                left++;
            } else {
                right--;
            }
        }

        return maxWater;
    
}
