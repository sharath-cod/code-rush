char* reverseWords(char* s) {
    int n = strlen(s);
    char *words[10000];
    int count = 0;

    int i = 0;
    while (i < n) {
        while (i < n && s[i] == ' ')
            i++;

        if (i == n)
            break;

        int start = i;
        while (i < n && s[i] != ' ')
            i++;

        int len = i - start;

        words[count] = (char *)malloc(len + 1);
        strncpy(words[count], s + start, len);
        words[count][len] = '\0';
        count++;
    }

   
    char *result = (char *)malloc(n + 1);
    result[0] = '\0';

    for (i = count - 1; i >= 0; i--) {
        strcat(result, words[i]);
        if (i > 0)
            strcat(result, " ");
        free(words[i]);
    }

  

    return result;
}
